# ---------------------------------------------------------------------------
# VGM Labs — environment template
#
# ⚠️  THIS FILE IS COMMITTED TO GIT. Never put a real secret in it.
#     Keys, tokens and passwords belong in `.env.local`, which is gitignored.
#     Anything pasted here becomes public the moment the repo is pushed.
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# Every variable is optional. The site builds, exports and runs without any of
# them; unset values fall back to documented defaults.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Canonical origin  (recommended — set before the first real deploy)
# ---------------------------------------------------------------------------
# Drives canonical URLs, sitemap entries, Open Graph URLs and JSON-LD @id.
# No trailing slash. Must be the domain your DNS points at.
NEXT_PUBLIC_SITE_URL=https://vgmlabs.ai


# ---------------------------------------------------------------------------
# GitHub Pages subpath  (leave empty when using a custom domain)
# ---------------------------------------------------------------------------
# Only needed when the site is served from a repository subpath, e.g.
#   https://<user>.github.io/VGMLabs-website  ->  /VGMLabs-website
# With a custom apex domain (the intended setup) leave this blank.
NEXT_PUBLIC_BASE_PATH=


# ---------------------------------------------------------------------------
# Contact form transport
# ---------------------------------------------------------------------------
# GitHub Pages is static hosting: there is no server to receive a POST. The form
# therefore uses a client-side transport adapter (src/lib/contact/transport.ts).
#
#   unset        ->  mailto transport. The validated submission is composed into
#                    a prefilled email to the address below, with a
#                    copy-to-clipboard fallback if no mail client opens.
#                    No third party, no cost, nothing to leak.
#
#   set to a URL ->  HTTP transport. The submission is POSTed as JSON to this
#                    endpoint — a form service (Web3Forms, Formspree) or your own
#                    function if the site later moves to a host that runs code.
#                    See docs/DEPLOYMENT.md.
#
# NOTE: NEXT_PUBLIC_* values are inlined into the client bundle and readable by
# anyone who views source. Only ever put a *public* form-service key here.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Where enquiries go. Also rendered as the visible fallback address.
NEXT_PUBLIC_CONTACT_EMAIL=info.vgmlabs@gmail.com


# ---------------------------------------------------------------------------
# Not required by this project
# ---------------------------------------------------------------------------
# You do NOT need a GitHub personal access token here. The Pages deploy workflow
# (.github/workflows/deploy.yml) uses the GITHUB_TOKEN that Actions injects
# automatically, and `git push` uses your local git credentials.
