/**
 * Serverless contact route — REFERENCE TEMPLATE, NOT ACTIVE CODE.
 *
 * This file is intentionally `.example` and lives outside `src/`. The site is built
 * with `output: 'export'` for GitHub Pages, and a POST route handler cannot be
 * statically exported — Next fails the build if one exists. So this sits here until
 * it is needed.
 *
 * ── To activate, on a host that runs code (Vercel, Netlify Functions, Cloudflare
 *    Workers, a Node server):
 *
 *   1. Remove `output: 'export'` and `trailingSlash` from next.config.ts
 *   2. Copy this file to  src/app/api/contact/route.ts
 *   3. Set NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact
 *   4. Set RESEND_API_KEY, CONTACT_FROM_EMAIL and CONTACT_TO_EMAIL in the host's
 *      environment (server-side only — no NEXT_PUBLIC_ prefix, so they stay secret)
 *   5. Add `resend` to dependencies, or keep the fetch-based call below, which has no
 *      dependency at all
 *
 * Nothing in src/components changes. The validation module is already shared: the
 * same rules that run in the browser run here, so a submission cannot bypass them by
 * skipping the UI.
 *
 * ── What this adds over the static mailto transport:
 *
 *   - real per-IP rate limiting (the client-side throttle is not a security control)
 *   - server-side validation that cannot be bypassed
 *   - delivery that does not depend on the visitor having a mail client
 *   - honest failure: if no provider is configured it returns 503 rather than
 *     claiming success
 */

import { NextResponse } from 'next/server';
import {
  isLikelyBot,
  labelFor,
  validateContact,
  BUDGET_OPTIONS,
  CONTACT_STAGES,
  DEPLOYMENT_OPTIONS,
  type ContactSubmission,
} from '@/lib/validation/contact';

/* -------------------------------------------------------------------------- */
/* Rate limiting                                                              */
/* -------------------------------------------------------------------------- */

/**
 * Adapter boundary.
 *
 * The in-memory implementation below is correct for a single long-lived Node process
 * and useless on serverless, where each instance has its own memory and the window
 * resets unpredictably. Swap in a shared store for anything real.
 */
interface RateLimiter {
  /** Returns false when the caller has exhausted its window. */
  check(key: string): Promise<{ allowed: boolean; retryAfterSeconds: number }>;
}

const LIMIT = Number(process.env.CONTACT_RATE_LIMIT ?? 5);
const WINDOW_SECONDS = Number(process.env.CONTACT_RATE_WINDOW_SECONDS ?? 3600);

/** Fixed window in process memory. Fine for a single Node server. */
function createMemoryLimiter(): RateLimiter {
  const hits = new Map<string, number[]>();

  return {
    async check(key) {
      const now = Date.now();
      const windowMs = WINDOW_SECONDS * 1000;
      const recent = (hits.get(key) ?? []).filter((time) => now - time < windowMs);

      if (recent.length >= LIMIT) {
        const oldest = Math.min(...recent);
        return {
          allowed: false,
          retryAfterSeconds: Math.ceil((windowMs - (now - oldest)) / 1000),
        };
      }

      recent.push(now);
      hits.set(key, recent);

      // Bound the map so a flood of unique IPs cannot grow it without limit.
      if (hits.size > 10_000) {
        for (const [k, times] of hits) {
          if (times.every((time) => now - time >= windowMs)) hits.delete(k);
        }
      }

      return { allowed: true, retryAfterSeconds: 0 };
    },
  };
}

/**
 * Upstash Redis limiter — a sketch of the shared-store version.
 *
 * Uses INCR with an EXPIRE on first write, which is a fixed window rather than a
 * sliding one: cheap, and adequate for a contact form.
 */
function createRedisLimiter(url: string, token: string): RateLimiter {
  return {
    async check(key) {
      const redisKey = `contact:${key}`;
      const headers = { Authorization: `Bearer ${token}` };

      const incr = await fetch(`${url}/incr/${encodeURIComponent(redisKey)}`, { headers });
      const { result: count } = (await incr.json()) as { result: number };

      if (count === 1) {
        await fetch(`${url}/expire/${encodeURIComponent(redisKey)}/${WINDOW_SECONDS}`, {
          headers,
        });
      }

      if (count > LIMIT) {
        const ttl = await fetch(`${url}/ttl/${encodeURIComponent(redisKey)}`, { headers });
        const { result } = (await ttl.json()) as { result: number };
        return { allowed: false, retryAfterSeconds: Math.max(1, result) };
      }

      return { allowed: true, retryAfterSeconds: 0 };
    },
  };
}

const limiter: RateLimiter = (() => {
  const url = process.env.UPSTASH_REDIS_REST_URL;
  const token = process.env.UPSTASH_REDIS_REST_TOKEN;
  return url && token ? createRedisLimiter(url, token) : createMemoryLimiter();
})();

/* -------------------------------------------------------------------------- */
/* Delivery                                                                   */
/* -------------------------------------------------------------------------- */

interface DeliveryAdapter {
  readonly name: string;
  send(subject: string, body: string, replyTo: string): Promise<void>;
}

/**
 * Resend over plain fetch — no SDK dependency.
 * The sending domain must be verified in Resend, or use their onboarding sender.
 */
function createResendAdapter(apiKey: string): DeliveryAdapter {
  const from = process.env.CONTACT_FROM_EMAIL ?? 'website@vgmlabs.ai';
  const to = process.env.CONTACT_TO_EMAIL ?? 'info.vgmlabs@gmail.com';

  return {
    name: 'resend',
    async send(subject, body, replyTo) {
      const response = await fetch('https://api.resend.com/emails', {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${apiKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          from,
          to: [to],
          // So a reply from the inbox goes to the enquirer, not to the sender domain.
          reply_to: replyTo,
          subject,
          text: body,
        }),
      });

      if (!response.ok) {
        throw new Error(`Resend responded ${response.status}: ${await response.text()}`);
      }
    },
  };
}

function resolveAdapter(): DeliveryAdapter | null {
  const apiKey = process.env.RESEND_API_KEY;
  return apiKey ? createResendAdapter(apiKey) : null;
}

/* -------------------------------------------------------------------------- */
/* Handler                                                                    */
/* -------------------------------------------------------------------------- */

function clientKey(request: Request): string {
  // Trust only the header your host actually sets. On Vercel that is
  // x-forwarded-for; on Cloudflare, cf-connecting-ip. Reading an arbitrary
  // client-supplied header would make the limiter trivially bypassable.
  const forwarded = request.headers.get('x-forwarded-for');
  return forwarded?.split(',')[0]?.trim() || 'unknown';
}

function formatBody(values: ContactSubmission): string {
  const lines = [
    `Name:          ${values.name.trim()}`,
    `Email:         ${values.email.trim()}`,
    `Organisation:  ${values.organisation.trim()}`,
    `Stage:         ${labelFor(values.stage, CONTACT_STAGES)}`,
    `Deployment:    ${labelFor(values.deployment, DEPLOYMENT_OPTIONS)}`,
  ];
  if (values.budget) lines.push(`Budget:        ${labelFor(values.budget, BUDGET_OPTIONS)}`);
  lines.push('', 'What they are trying to build', '—'.repeat(32), values.brief.trim());
  if (values.message.trim()) {
    lines.push('', 'Additional context', '—'.repeat(32), values.message.trim());
  }
  return lines.join('\n');
}

export async function POST(request: Request) {
  let payload: unknown;
  try {
    payload = await request.json();
  } catch {
    return NextResponse.json({ ok: false, error: 'Malformed request body.' }, { status: 400 });
  }

  const values = payload as ContactSubmission;

  // Same rules as the browser. A client that skips the UI gains nothing.
  const errors = validateContact(values);
  if (Object.keys(errors).length > 0) {
    return NextResponse.json({ ok: false, errors }, { status: 422 });
  }

  // Accept and discard. Telling the automation it was detected teaches it to adapt.
  if (isLikelyBot(values)) {
    return NextResponse.json({ ok: true });
  }

  const { allowed, retryAfterSeconds } = await limiter.check(clientKey(request));
  if (!allowed) {
    return NextResponse.json(
      { ok: false, error: 'Too many enquiries from this address. Please try again later.' },
      { status: 429, headers: { 'Retry-After': String(retryAfterSeconds) } },
    );
  }

  const adapter = resolveAdapter();
  if (!adapter) {
    // Honest failure. Returning 200 here would tell the visitor their message was
    // received when it was not.
    return NextResponse.json(
      {
        ok: false,
        error:
          'Email delivery is not configured on this deployment. Please email info.vgmlabs@gmail.com directly.',
      },
      { status: 503 },
    );
  }

  try {
    await adapter.send(
      `Enquiry — ${values.organisation.trim()} (${labelFor(values.stage, CONTACT_STAGES)})`,
      formatBody(values),
      values.email.trim(),
    );
  } catch (error) {
    // Log server-side; never leak provider detail to the client.
    console.error('[contact] delivery failed', error);
    return NextResponse.json(
      {
        ok: false,
        error:
          'We could not send your enquiry. Please email info.vgmlabs@gmail.com directly.',
      },
      { status: 502 },
    );
  }

  return NextResponse.json({ ok: true });
}

/** Reject anything that is not a POST, rather than returning an HTML 404. */
export async function GET() {
  return NextResponse.json({ ok: false, error: 'Method not allowed.' }, { status: 405 });
}
